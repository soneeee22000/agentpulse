# ── Backend (apps/api) ───────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
CORS_ORIGIN=*

# Event bus driver: "memory" (default, fully offline), "pubsub" (GCP), or "kafka".
BUS_DRIVER=memory

# Start the synthetic traffic simulator automatically on boot so the
# dashboard is alive with zero clicks. Set to "false" to start it manually.
SIM_AUTOSTART=true

# Serve the GraphiQL explorer at /graphiql.
GRAPHIQL=true

# ── GCP Pub/Sub (only when BUS_DRIVER=pubsub) ────────────────────────
# Standard Google credentials apply (GOOGLE_APPLICATION_CREDENTIALS, ADC).
GCP_PROJECT_ID=
PUBSUB_TOPIC=agentpulse-events
PUBSUB_SUBSCRIPTION=agentpulse-events-sub

# ── Apache Kafka (only when BUS_DRIVER=kafka) ────────────────────────
# `docker compose --profile kafka up` starts a broker on localhost:9092.
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=agentpulse-events
KAFKA_GROUP_ID=agentpulse-api
KAFKA_CLIENT_ID=agentpulse

# ── Frontend (apps/web) ──────────────────────────────────────────────
VITE_API_URL=http://localhost:8080
