PORT=8080
HOST=0.0.0.0
# Demo default; set explicit comma-separated origins in production.
CORS_ORIGIN=*

# Event bus driver: "memory" (default, offline), "pubsub" (GCP), or "kafka".
BUS_DRIVER=memory

# Auto-start the synthetic traffic simulator on boot.
SIM_AUTOSTART=true

# Serve the GraphiQL explorer at /graphiql.
GRAPHIQL=true

# Only used when BUS_DRIVER=pubsub (standard Google ADC credentials apply).
GCP_PROJECT_ID=
PUBSUB_TOPIC=agentpulse-events
PUBSUB_SUBSCRIPTION=agentpulse-events-sub

# Only used when BUS_DRIVER=kafka. Brokers are comma-separated host:port.
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=agentpulse-events
KAFKA_GROUP_ID=agentpulse-api
KAFKA_CLIENT_ID=agentpulse
